# Add these in Vercel Project Settings -> Environment Variables.
# Never commit real secrets to GitHub.
RESEND_API_KEY=re_your_private_api_key
# Optional: set this to your deployed website origin, e.g. https://your-domain.com
SITE_ORIGIN=
# Optional: use a sender address on a domain verified in Resend.
# Until then, the API defaults to Resend's onboarding sender.
CONTACT_FROM_EMAIL=
